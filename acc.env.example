# Optional: copy to `acc.env` in this directory (gitignored), then run
# `python session.py --seed` - or just run `python session.py` and type the
# logins interactively (recommended).  For the Docker stack, copy it to
# `data/acc.env` instead; the container seeds the session from it on first
# boot.
#
# Both terminals accept any account, demo or live, from any broker.

account 1
login=YOUR_LOGIN_1
password=YOUR_PASSWORD_1
server=YOUR-BROKER-SERVER-1

account 2
login=YOUR_LOGIN_2
password=YOUR_PASSWORD_2
server=YOUR-BROKER-SERVER-2

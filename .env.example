# Copy this file to `.env` (gitignored) before `docker compose up --build`.
# `make docker` creates a .env with a random key for you on first run.
#
# MT5_MACHINE_KEY derives the key that obfuscates the stored account session
# (session.json).  Keep it STABLE across container recreations, otherwise the
# stored logins cannot be decrypted and you must log in again.
MT5_MACHINE_KEY=change-me-to-a-long-random-string

# Optional overrides (defaults shown).
#MT5_WEB_PORT=8000              # host port for the panel
#MT5_NO_LAUNCH_JITTER=1
#MT5_TRADING_DAYS=0,1,2,3,4,5,6
#MT5_CORS_ORIGIN=               # exact origin if an external dashboard must call the API
#MT5_DATABASE_URL=              # PostgreSQL DSN; SQLite inside /data is used when unset
